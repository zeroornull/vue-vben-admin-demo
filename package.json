{
  "name": "vue-admin",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "catalog": {
      "@vitejs/plugin-vue": "^6.0.8",
      "pinia": "^4.0.2",
      "typescript": "~6.0.0",
      "vite": "^8.1.5",
      "vue": "^3.5.40",
      "vue-router": "^5.2.0",
      "vue-tsc": "^3.3.7"
    },
    "packages": ["apps/*", "packages/*"]
  },
  "scripts": {
    "dev": "bun run --filter @app/web dev",
    "build": "bun run --filter @app/web build",
    "preview": "bun run --filter @app/web preview",
    "typecheck": "bun run --filter '*' type-check",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint"
  }
}
