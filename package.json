{
  "name": "vue-admin",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "catalog": {
      "@vitejs/plugin-vue": "^6.0.8",
      "pinia": "^4.0.2",
      "typescript": "~6.0.0",
      "vite": "^8.1.5",
      "vue": "^3.5.40",
      "vue-router": "^5.2.0",
      "vue-tsc": "^3.3.7"
    },
    "packages": ["apps/*", "packages/*"]
  },
  "scripts": {
    "dev": "bun run --filter @app/web dev",
    "dev:ele": "bun run --filter @app/web-ele dev",
    "dev:naive": "bun run --filter @app/web-naive dev",
    "dev:tdesign": "bun run --filter @app/web-tdesign dev",
    "dev:antdv-next": "bun run --filter @app/web-antdv-next dev",
    "dev:vapor": "bun run --filter @app/web-vapor dev",
    "docs": "bun run --filter @app/docs dev",
    "docs:build": "bun run --filter @app/docs build",
    "build": "turbo run build",
    "preview": "bun run --filter @app/web preview",
    "typecheck": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "bun run --filter @app/web test:e2e",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@vue/tsconfig": "^0.9.1",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "vue": "catalog:"
  }
}
