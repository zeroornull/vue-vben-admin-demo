{
  "name": "vue-admin",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --filter @app/web dev",
    "build": "bun run --filter @app/web build",
    "preview": "bun run --filter @app/web preview",
    "typecheck": "bun run --filter @app/web type-check",
    "test": "bun run --filter @app/web test",
    "lint": "bun run --filter @app/web lint"
  }
}
